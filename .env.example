# Docker Compose n'a besoin d'aucun réglage : ce fichier est facultatif.
# Copié vers .env (jamais versionné), il sert à lancer le backend hors Docker
# ou à ajuster la démonstration.

# --- Docker Compose et lancement hors Docker ---

# Clé de l'API Claude, pour la rédaction des réponses
ANTHROPIC_API_KEY=

# Premier administrateur, créé au démarrage s'il n'existe pas (mot de passe : 10 caractères minimum)
SESAME_ADMIN_EMAIL=
SESAME_ADMIN_MOT_DE_PASSE=

# « true » charge l'entreprise fictive et ses comptes au mot de passe public
SESAME_DEMO=true

# « false » uniquement en local sans HTTPS : le cookie de session exige sinon une connexion chiffrée
SESAME_COOKIE_SECURISE=false

# --- Lancement hors Docker seulement (Compose génère ces deux secrets lui-même) ---

SESAME_DB_URL=jdbc:postgresql://localhost:5432/sesame
SESAME_DB_UTILISATEUR=sesame
SESAME_DB_MOT_DE_PASSE=a-remplacer

# Clé de signature des jetons d'accès : au moins 32 caractères aléatoires (openssl rand -base64 48)
SESAME_JWT_SECRET=a-remplacer-par-48-octets-aleatoires
